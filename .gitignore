# --------------------------------------------------------------------
# Python
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# --------------------------------------------------------------------
# Virtual environments
# --------------------------------------------------------------------
.venv*/
venv/
env/
.env
.python-version

# --------------------------------------------------------------------
# Tooling caches
# --------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# --------------------------------------------------------------------
# IDE / editor
# --------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --------------------------------------------------------------------
# Notebooks (committed clean; nbstripout enforces this via pre-commit)
# --------------------------------------------------------------------
.ipynb_checkpoints/

# --------------------------------------------------------------------
# Scientific data, model artifacts, generated banks
# Never commit binary data — it bloats the repo and breaks `git clone`.
# Use external storage (HuggingFace Hub, S3, PhysioNet) instead.
# --------------------------------------------------------------------
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.ckpt
*.safetensors

# Root-anchored (leading /) on purpose: an unanchored `data/` swallowed a
# same-named source package in egm-classifier — local stayed green, CI failed
# with ModuleNotFoundError. Anchoring keeps the ignore to the real artifact
# directory and leaves `src/**/data/`, `src/**/configs/`, etc. trackable.
/data/
/banks/
/checkpoints/
/runs/
/logs/
/mlruns/
/wandb/
/artifacts/

# --------------------------------------------------------------------
# Per-phase working configs
# Generation configs Daniel iterates on during a phase are scratch, not
# deliverables — they change constantly and would churn the history.
# Configs meant to be shared live in examples/ and are tracked there.
# --------------------------------------------------------------------
/configs/

# Allow tiny fixtures committed under tests/fixtures/ if needed:
!tests/fixtures/**

# --------------------------------------------------------------------
# Build / docs
# --------------------------------------------------------------------
docs/_build/
site/
